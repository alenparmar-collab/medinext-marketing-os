# ---------------------------------------------------------------------------
# MediNext Marketing OS — environment
#
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# The placeholders below are long enough to satisfy the validation in
# src/lib/env.ts, so a straight copy boots and the smoke test runs. They are
# not real credentials: every Supabase call fails auth, which is exactly the
# anonymous-visitor behaviour the smoke test asserts.
# ---------------------------------------------------------------------------

# Safe to expose to the browser. The anon key is public by design; RLS is what
# protects the data (see docs/architecture/05-security-model.md).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-project-anon-key

# SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Used only through withServiceRole() in src/server/privileged/, which writes an
# audit row on every use.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-project-service-role-key

# Public origin, used for auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MAILBOX INGESTION (Build 6)
#
# All optional: without them the mailbox screen says the deployment is not
# configured and nothing else changes. Email is never required for the CRM to
# work.
# ---------------------------------------------------------------------------

# Google OAuth client, from the Google Cloud console. The SECRET belongs here
# and is never written to a database column.
#
# The only scope requested is https://www.googleapis.com/auth/gmail.readonly.
# There is no send scope and no code path that could use one.
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-your-oauth-client-secret

# 32 bytes, base64. Encrypts provider tokens BEFORE they reach Postgres, so a
# database dump yields ciphertext and nothing usable. Generate with:
#     openssl rand -base64 32
# Rotating it invalidates every stored mailbox authorisation; reconnect after.
MAILBOX_TOKEN_KEY=replace-with-a-base64-32-byte-key

# Set to `fixture` to run the explorer against in-memory sample messages
# instead of a real mailbox. Development only.
# MAILBOX_PROVIDER=fixture
