# ---------------------------------------------------------------------------
# MediNext Marketing OS — environment
#
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# The placeholders below are long enough to satisfy the validation in
# src/lib/env.ts, so a straight copy boots and the smoke test runs. They are
# not real credentials: every Supabase call fails auth, which is exactly the
# anonymous-visitor behaviour the smoke test asserts.
# ---------------------------------------------------------------------------

# Safe to expose to the browser. The anon key is public by design; RLS is what
# protects the data (see docs/architecture/05-security-model.md).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-project-anon-key

# SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Used only through withServiceRole() in src/server/privileged/, which writes an
# audit row on every use.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-project-service-role-key

# Public origin, used for auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
